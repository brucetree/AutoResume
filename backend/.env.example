PORT=5000
NEXTAUTH_SECRET=your-nextauth-secret-here
FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Database ----
# Development (local): connect to autoresume_dev
# Production (EC2):    connect to autoresume_prod
# CI Testing:          connect to autoresume_test
# MONGO_URI: set to the correct database per environment
#   Local dev → autoresume_dev
#   EC2 prod  → autoresume_prod
#   CI test   → autoresume_test
MONGO_URI=mongodb+srv://<user>:<password>@cluster.xxxxx.mongodb.net/autoresume_dev
MONGO_URI_TEST=mongodb+srv://<user>:<password>@cluster.xxxxx.mongodb.net/autoresume_test

# ---- File Storage ----
# local = multer disk storage (for local dev)
# s3    = AWS S3 (for production on EC2)
STORAGE_TYPE=local

# Required when STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=
